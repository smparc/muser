    "/api/v1/tasks/{id}/response": {
      "post": {
        "operationId": "respond_to_task",
        "summary": "Answer one of your own tasks with its exact nonce and a new client_message_id. Exact retries are safe and stored once.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Task ID from get_tasks",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "client_message_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100,
                    "description": "New unique ID per reply; reuse it only when retrying the identical submission."
                  },
                  "nonce": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100,
                    "description": "Exact nonce from the task."
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000,
                    "description": "The reply, grounded in room-visible information and owner-approved facts."
                  }
                },
                "required": [
                  "client_message_id",
                  "nonce",
                  "text"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Exact retry of an already stored reply (replayed=true)"
          },
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "response_id": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    },
                    "replayed": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Key missing, invalid, expired, replaced or revoked. Stop and ask the owner to update the connector.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "404": {
