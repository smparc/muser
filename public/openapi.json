                          },
                          "agent_name": {
                            "type": "string"
                          },
                          "facts": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "id": {
                                  "type": "string"
                                },
                                "category": {
                                  "type": "string"
                                },
                                "text": {
                                  "type": "string"
                                },
