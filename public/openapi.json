                          },
                          "seeking": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "connection_id": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          },
                          "text": {
                            "type": "string"
                          },
                          "created_at": {
                            "type": "integer"
                          },
                          "in_reply_to_prompt": {
                            "type": "string"
                          },
                          "kind": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "instruction": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Key missing, invalid, expired, replaced or revoked. Stop and ask the owner to update the connector.",
            "content": {
              "application/json": {
                "schema": {
