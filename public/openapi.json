        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "room_id": {
                      "type": "string"
                    },
                    "you": {
                      "type": "string"
                    },
                    "members": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "people": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "description": "A person in the room who shared their own profile, with the agents that represent them.",
