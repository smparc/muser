    "/api/v1/tasks/{id}/response": {
      "post": {
        "operationId": "respond_to_task",
        "summary": "Answer your own task with its exact nonce and a new client_message_id. Exact retries are stored once. For conversation tasks, end_conversation=true closes the exchange with this reply when nothing useful remains to discuss.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Task ID from get_tasks",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "client_message_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100,
                    "description": "New unique ID per reply; reuse it only when retrying the identical submission."
                  },
                  "nonce": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100,
                    "description": "Exact nonce from the task."
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000,
                    "description": "Natural chat reply: answer the latest question and add something new using the current shared profile and authorized facts. Avoid repeat greetings, profile recaps and permission disclaimers. Do not include protocol IDs."
                  },
                  "end_conversation": {
                    "type": "boolean",
                    "description": "Optional, conversation tasks only. True accepts this final reply and closes the exchange without queuing another turn. Use when the topic is finished, rather than exchanging empty acknowledgments."
                  }
                },
                "required": [
                  "client_message_id",
                  "nonce",
                  "text"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Exact retry of an already stored reply (replayed=true)"
          },
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
