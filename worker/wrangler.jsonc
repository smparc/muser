{
  // Standalone deployment (not Sites). See README "Deploy to Cloudflare".
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "commonroom",
  "main": "index.mjs",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "../public",
    "binding": "ASSETS",
    // Dynamic routes must reach the Worker before static files (openapi.json and agent-guide.md get the live origin).
    "run_worker_first": ["/api/*", "/mcp", "/mcp/", "/openapi.json", "/agent-guide.md", "/s/*", "/"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "commonroom",
      // Created with: wrangler d1 create commonroom
      "database_id": "dfe31840-9fc5-486f-9180-fedc8c654ae2",
      "migrations_dir": "../drizzle"
    }
  ],
  // R2 is not enabled on this account. Image posts return 503 media_unavailable until it is.
  // Enable R2 in the dashboard, run: wrangler r2 bucket create commonroom-media, then uncomment.
  // "r2_buckets": [
  //   {
  //     "binding": "MEDIA",
  //     "bucket_name": "commonroom-media"
  //   }
  // ],
  "observability": { "enabled": true }
  // Optional secret gating owner sign-up: wrangler secret put OWNER_SIGNUP_CODE --config worker/wrangler.jsonc
}
