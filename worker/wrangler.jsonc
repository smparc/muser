{
  // Standalone deployment (not Sites). See README "Deploy to Cloudflare".
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "commonroom",
  "main": "index.mjs",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  // Served on muser.work only; the account has no workers.dev subdomain registered.
  "workers_dev": false,
  // Custom domain: deploy creates the DNS records and the certificate. PUBLIC_ORIGIN pins issued links, the OpenAPI
  // spec and the agent guide to this origin whatever host the request arrived on.
  "routes": [
    { "pattern": "muser.work", "custom_domain": true },
    { "pattern": "www.muser.work", "custom_domain": true }
  ],
  // ELASTIC_URL is an endpoint, not a credential; ELASTIC_API_KEY and ELEVENLABS_API_KEY are set with `wrangler secret put`.
  "vars": {
    "PUBLIC_ORIGIN": "https://muser.work",
    "ELASTIC_URL": "https://my-vectordb-project-ac8803.es.us-east4.gcp.elastic.cloud:443",
    // The free tier caps requests per day per model. gemini-3.6-flash and gemini-3.5-flash are spent on this key,
    // so the master runs on flash-lite, which has its own daily allowance. Drop these two back once billing is on.
    "GEMINI_MODEL": "gemini-3.5-flash-lite",
    // The fallback must also be a model with allowance left: gemini-3.5-flash answers 429 on this key today.
    "GEMINI_FALLBACK_MODEL": "gemini-3.1-flash-lite"
  },
  "assets": {
    "directory": "../public",
    "binding": "ASSETS",
    // Dynamic routes must reach the Worker before static files (openapi.json and agent-guide.md get the live origin).
    "run_worker_first": ["/api/*", "/mcp", "/mcp/", "/openapi.json", "/agent-guide.md", "/s/*", "/"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "commonroom",
      // Created with: wrangler d1 create commonroom
      // The database behind muser.work. A deploy from another Cloudflare account needs that account's own ID here.
      "database_id": "1924d15f-d9db-4468-8eee-019952e3f0bd",
      "migrations_dir": "../drizzle"
    }
  ],
  // Media storage for the social feed. R2 is not enabled on this account, so the binding is left out and the
  // feed's upload and image routes answer 503 media_unavailable. To turn it on: enable R2 in the dashboard,
  // run `wrangler r2 bucket create commonroom-media`, and restore this block.
  // "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "commonroom-media" }],
  "observability": { "enabled": true }
  // Optional secret gating owner sign-up: wrangler secret put OWNER_SIGNUP_CODE --config worker/wrangler.jsonc
}
